{
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/claim",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/c",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/c",
      "destination": "/claim"
    }
  ],
  "redirects": [
    {
      "source": "/download/seeker",
      "destination": "https://github.com/seedless-labs/seedless-labs-landing/releases/download/clockin-1.0.4/seedless-1.0.4-seeker.apk",
      "permanent": false
    },
    {
      "source": "/downloads/seeker",
      "destination": "https://github.com/seedless-labs/seedless-labs-landing/releases/download/clockin-1.0.4/seedless-1.0.4-seeker.apk",
      "permanent": false
    }
  ]
}
